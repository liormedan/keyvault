{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyvault",
  "version": "0.1.0",
  "identifier": "com.liormedan.keyvault",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Key vault",
        "width": 920,
        "height": 700,
        "minWidth": 420,
        "minHeight": 420,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend.mjs": "backend.mjs"
    }
  }
}
