{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kv-vault",
  "version": "0.11.0",
  "identifier": "com.liormedan.keyvault",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kv-vault",
        "width": 920,
        "height": 700,
        "minWidth": 420,
        "minHeight": 420,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend.mjs": "backend.mjs",
      "resources/host.mjs": "host.mjs",
      "resources/extension/chrome/*": "extension/chrome/",
      "resources/extension/firefox/*": "extension/firefox/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNzlFQUUxMzc2RTUyNjkKUldScFVtNDM0ZXA1UWViZ21rcXlUb29Sd1dEY1BHc0Exd1JZL0pxSVUvaEgyOTRUcXpJV3dSd2cK",
      "endpoints": [
        "https://github.com/liormedan/kv-vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
