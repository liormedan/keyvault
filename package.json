{
  "name": "kv-vault",
  "version": "0.9.0",
  "description": "A local, encrypted vault for developer keys and passwords — one file, a Tauri desktop app and a CLI. libsodium only.",
  "license": "MIT",
  "author": "Lior Medan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liormedan/kv-vault.git"
  },
  "keywords": [
    "vault",
    "secrets",
    "password-manager",
    "env",
    "dotenv",
    "libsodium",
    "argon2",
    "tauri",
    "cli"
  ],
  "type": "module",
  "bin": {
    "kv": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci",
    "format": "biome format --write",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --no-warnings=ExperimentalWarning --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-lines=75 --test test/*.test.ts",
    "test:e2e": "node --experimental-strip-types --no-warnings=ExperimentalWarning test/e2e/app.e2e.ts",
    "test:extension": "node --experimental-strip-types --no-warnings=ExperimentalWarning test/e2e/extension.e2e.ts",
    "prepare": "node scripts/build.mjs",
    "app:build": "tauri build --no-bundle",
    "app:installer": "tauri build",
    "release": "node scripts/release.mjs",
    "app:build:e2e": "tauri build --no-bundle --config app/src-tauri/tauri.e2e.conf.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/liormedan/kv-vault#readme",
  "bugs": {
    "url": "https://github.com/liormedan/kv-vault/issues"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
